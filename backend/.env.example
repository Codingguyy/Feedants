PORT=5000
NODE_ENV=development

# MongoDB connection string. In production point this at a replica set
# (transactions used by this service require a replica set / mongos, not a
# standalone mongod).
MONGO_URI=mongodb://localhost:27017/feedants

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API from the RN app / web
CORS_ORIGIN=*
